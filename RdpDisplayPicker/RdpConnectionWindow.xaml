<Window x:Class="RdpDisplayPicker.RdpConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:forms="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        Title="RDP接続" Height="720" Width="1080" MinHeight="480" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        Closing="Window_Closing">
    <Grid Background="#202020">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="ConnectionStatusText"
                   Margin="12,8"
                   Foreground="White"
                   Text="RDP ActiveXを初期化しています..." />
        <forms:WindowsFormsHost x:Name="RdpHost" Grid.Row="1" />
    </Grid>
</Window>
